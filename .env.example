# Copy to `.env` for **local Node aggregator** (`pnpm --filter @kimchi/server`). Production is GitHub Pages (no server).

# HTTP listen port for local aggregator only.
PORT=3000

# Directory of the built SPA when the Node server serves it locally.
# STATIC_ROOT=../web/dist

# Set to 1 only behind a TLS terminator. GitHub Pages is already HTTPS.
# ENABLE_HSTS=1

# Never enable in production.
# FAULT_INJECTION=1

# Local Node Binance connector only (browser always uses wss://stream.binance.com:443):
# BINANCE_WS_BASE_URL=wss://data-stream.binance.vision:9443
# BINANCE_REST_TICKER_URL=https://data-api.binance.vision/api/v3/ticker/24hr

# Browser FX: open.er-api.com primary, Frankfurter fallback, cached in localStorage key `kimp:fx:{UTC-date}`.
